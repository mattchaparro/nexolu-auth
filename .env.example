# Copiar a .env y completar. El .env real NUNCA se commitea.
#
# La llave de firma se genera una sola vez con:
#   docker compose run --rm auth python -m scripts.generate_keypair
# Ese comando imprime AUTH_JWT_KID y AUTH_JWT_PRIVATE_KEY listos para pegar
# aca, y el NEXOLU_AUTH_PUBLIC_KEYS que va en el .env de cada consumidor.

# En produccion apunta al MySQL de nexolu-pos-prod por la VPC, igual que
# los otros servicios core.
DATABASE_URL=mysql+aiomysql://nexolu:<MYSQL_APP_PASSWORD>@10.116.0.6:3306/nexolu_auth

AUTH_ISSUER=https://auth.nexolu.co
AUTH_JWT_KID=
# PEM de la llave privada RSA, en base64 y en UNA sola linea.
AUTH_JWT_PRIVATE_KEY=

# 120 s: la asercion vive un instante en un fragmento de URL. Los
# verificadores aplican 60 s de leeway para absorber deriva de reloj.
AUTH_ASSERTION_TTL_SECONDS=120
# Cuanto dura el "no me vuelvas a pedir la contrasena" entre productos.
AUTH_SESSION_TTL_HOURS=12

# Catalogo de consumidores. `redirect_url` es a donde vuelve el navegador
# con el fragmento #auth_token=<jwt>; NO se acepta del query string, y por
# eso un open redirect es imposible en vez de algo que haya que filtrar.
AUTH_PRODUCTS_JSON={"nexolu-admin":{"name":"Panel de administracion","audience":"nexolu-admin","redirect_url":"https://admin.nexolu.co/iniciar-sesion"},"nexolu-pos-api":{"name":"Nexolu POS","audience":"nexolu-pos-api","redirect_url":"https://new-pos.nexolu.co/iniciar-sesion"},"nexolu-spa-api":{"name":"Nexolu Agenda","audience":"nexolu-spa-api","redirect_url":"https://agenda.nexolu.co/iniciar-sesion"}}

AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_MINUTES=15

# Solo se pone en false para desarrollo local sobre http://localhost, que
# no acepta cookies Secure. En produccion NUNCA.
AUTH_COOKIE_SECURE=true

# Para los endpoints /v1/admin/* (administracion de identidades).
NEXOLU_PLATFORM_API_KEY=

LOG_LEVEL=INFO
